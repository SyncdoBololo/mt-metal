---
import Photo from './Photo.astro';
import hero from '../assets/img/01-hero-solda-tubo.jpg';
import {whatsappUrl} from '../data/empresa';
---
<section class="hero" aria-labelledby="hero-title"><div class="hero-media"><Photo src={hero} alt="Soldador com máscara trabalhando em um tubo de aço dentro da fábrica" eager sizes="100vw"/><video id="hero-video" autoplay muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video></div><div class="hero-shade"></div><div class="hero-glow" aria-hidden="true"></div><canvas class="sparks" aria-hidden="true"></canvas><div class="hero-content wrap"><p class="eyebrow"><span class="tiny-cross" aria-hidden="true">+</span> VÁRZEA GRANDE, MT <span class="kicker-rule"></span> DESDE 2023</p><h1 id="hero-title">AÇO QUE<br/><span class="outline-word">SUSTENTA</span><br/>A OBRA<span class="orange">.</span><span class="sr-only"> Armação e estruturas metálicas em Várzea Grande</span></h1><div class="hero-bottom"><div><p class="hero-description">Da armação à estrutura.<br/>Do projeto ao canteiro.</p><div class="actions"><a class="button primary" href={whatsappUrl} target="_blank" rel="noopener">Pedir orçamento <span aria-hidden="true">↗</span><span class="sr-only"> no WhatsApp</span></a><a class="button secondary" href="#servicos">Ver serviços <span aria-hidden="true">↓</span></a></div></div><div class="hero-note mono"><span>01 / MATÉRIA-PRIMA</span><span>AÇO. PRECISÃO. ESTRUTURA.</span></div></div></div><div class="hero-baseline wrap mono"><span>ARMAÇÃO · ESTRUTURAS METÁLICAS · CONSTRUÇÃO CIVIL</span><a href="#sobre" aria-label="Role para explorar a empresa">ROLE PARA EXPLORAR ↓</a></div><div class="load-line" aria-hidden="true"><span></span><b>000</b></div></section>

