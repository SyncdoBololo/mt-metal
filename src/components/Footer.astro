---
import {withBase} from '../lib/url';
import {empresa,whatsappUrl,contatos} from '../data/empresa';
import {servicos} from '../data/servicos';
---
<footer class="footer wrap"><div class="footer-top"><p class="mono">A BASE É O AÇO.<br/>O PRÓXIMO PASSO É SEU.</p><a class="text-link" href={whatsappUrl}>Vamos falar da sua obra <span aria-hidden="true">↗︎</span></a></div><div class="footer-word" aria-hidden="true">MT METAL</div><div class="footer-grid"><div><strong>{empresa.razaoSocial}</strong><p>{empresa.endereco}</p></div><nav aria-label="Serviços no rodapé">{servicos.map(s=><a href={withBase(`/servicos/${s.slug}/`)}>{s.titulo}</a>)}</nav><div><a href={`tel:${empresa.tel}`}>{empresa.telefone}</a>{contatos.map(contato=><a href={contato.url}>{contato.setor} · {contato.formatado}</a>)}<a href={`mailto:${empresa.email}`}>{empresa.email}</a><p>Várzea Grande · Mato Grosso</p></div></div><div class="footer-bottom mono"><span>© {new Date().getFullYear()} MT METAL LTDA</span><span>Portfólio: acervo MT METAL · demais imagens ilustrativas</span><a href="#main">Voltar ao topo ↑</a></div></footer>

