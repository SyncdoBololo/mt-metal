---
import logo from '../assets/brand/logo-mt-metal.svg?url';
import {withBase} from '../lib/url';
import {whatsappUrl} from '../data/empresa';
---
<header class="header"><a class="brand" href={withBase("/")}><img class="brand-logo" src={logo} alt="MT METAL Metalúrgica" width="406" height="108"/><span class="sr-only">, página inicial</span></a><nav class="desktop-nav" aria-label="Principal"><a href={withBase("/#sobre")}>A empresa</a><a href={withBase("/#servicos")}>Serviços</a><a href={withBase("/#portfolio")}>Portfólio</a><a href={withBase("/#contato")}>Contato</a></nav><a class="header-cta" href={whatsappUrl} target="_blank" rel="noopener">Pedir orçamento <span aria-hidden="true">↗︎</span></a><button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">Menu <span aria-hidden="true">☰</span></button></header>
<dialog id="mobile-menu" aria-label="Menu de navegação"><button class="menu-close" aria-label="Fechar menu">Fechar ✕</button><nav aria-label="Menu móvel"><a href={withBase("/#sobre")}>A empresa</a><a href={withBase("/#servicos")}>Serviços</a><a href={withBase("/#portfolio")}>Portfólio</a><a href={withBase("/#contato")}>Contato</a><a href={whatsappUrl}>Pedir orçamento ↗︎</a></nav></dialog>

