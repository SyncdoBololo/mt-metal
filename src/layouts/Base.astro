---
import {withBase} from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {empresa,whatsappUrl} from '../data/empresa';
import '@fontsource-variable/archivo/standard.css';
import archivoFont from '../assets/fonts/archivo-hero.woff2?url';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
interface Props { title?:string; description?:string; noindex?:boolean; extraSchema?:Record<string,unknown>[]; }
const {title='MT METAL · Armação e estruturas metálicas em Várzea Grande',description='Corte e dobra de ferragem, estruturas metálicas, reservatórios, andaimes e construção civil em Várzea Grande, Cuiabá e região.',noindex=false,extraSchema=[]}=Astro.props;
const home = new URL(withBase('/'),Astro.site).href;
const canonical = new URL(Astro.url.pathname,Astro.site);
const schema={'@context':'https://schema.org','@type':'GeneralContractor','@id':`${home}#empresa`,name:empresa.nome,legalName:empresa.razaoSocial,taxID:empresa.cnpj,foundingDate:'2023-05-09',telephone:empresa.tel,url:home,image:new URL(withBase('/og.jpg'),Astro.site).href,address:{'@type':'PostalAddress',streetAddress:'Rua Mar Vermelho, s/n, Quadra 4, Lote 1, Parque Industrial Atlântico, Santa Isabel',addressLocality:'Várzea Grande',addressRegion:'MT',postalCode:'78150-202',addressCountry:'BR'},areaServed:['Várzea Grande','Cuiabá']};
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><link rel="preload" href={archivoFont} as="font" type="font/woff2" crossorigin="anonymous"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content="#0B0C0E"/><link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml"/><link rel="icon" href={withBase("/favicon.png")} sizes="32x32"/><link rel="manifest" href={withBase("/manifest.webmanifest")}/>{noindex ? <meta name="robots" content="noindex"/> : <link rel="canonical" href={canonical}/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="pt_BR"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(withBase('/og.jpg'),Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(withBase('/og.jpg'),Astro.site)}/><script type="application/ld+json" set:html={JSON.stringify(schema)}/>{extraSchema.map(s=> <script type="application/ld+json" set:html={JSON.stringify(s)}/>)}</head><body><a href="#main" class="skip-link">Pular para o conteúdo</a><Header/><main id="main"><slot/></main><Footer/><a class="floating-wa" href={whatsappUrl} aria-label="Conversar com a MT METAL no WhatsApp">WhatsApp ↗</a><div class="transition-doors" aria-hidden="true">{Array.from({length:6},()=> <span/>)}</div><div class="custom-cursor" aria-hidden="true"></div><script>import '../scripts/main';</script></body></html>


