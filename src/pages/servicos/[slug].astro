---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import {servicos} from '../../data/servicos';
import {whatsappUrl} from '../../data/empresa';
export function getStaticPaths(){return servicos.map(servico=>({params:{slug:servico.slug},props:{servico}}));}
const {servico:s}=Astro.props;
---
<Base title={`${s.titulo} em Várzea Grande · MT METAL`} description={s.meta}><section class="service-hero wrap"><nav aria-label="Caminho de navegação" class="breadcrumb mono"><a href="/">INÍCIO</a> / <a href="/#servicos">SERVIÇOS</a> / {s.curto.toUpperCase()}</nav><div class="service-detail-grid"><div><p class="eyebrow">MT METAL / {s.curto.toUpperCase()}</p><h1>{s.titulo}<span class="orange">.</span></h1><p class="service-subtitle">{s.subtitulo}</p><p>{s.descricao}</p><a href={whatsappUrl} class="button primary">Solicitar orçamento ↗</a><p class="mono cnae">CNAE {s.cnaes.join(' · ')}</p></div><figure class:list={['service-detail-image',{'tank-image':s.slug==='reservatorios'}]}><Photo src={s.imagem} alt={s.alt} eager/><figcaption class="mono">IMAGEM ILUSTRATIVA · {s.curto.toUpperCase()}</figcaption></figure></div></section><section class="section wrap detail-scope"><div><p class="eyebrow">01 / ESCOPO</p><h2>O QUE<br/>ESTÁ <span class="outline-word">INCLUÍDO.</span></h2></div><ul>{s.inclui.map((item,i)=><li><span class="mono orange">0{i+1}</span>{item}</li>)}</ul></section><section class="section wrap faq"><div><p class="eyebrow">02 / ANTES DE COMEÇAR</p><h2>DÚVIDAS<br/>FREQUENTES.</h2></div><div>{s.faq.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section><section class="detail-cta section wrap"><p class="eyebrow">VÁRZEA GRANDE · CUIABÁ E REGIÃO</p><h2>VAMOS FALAR<br/>DA SUA <span class="orange">OBRA?</span></h2><div class="actions"><a class="button primary" href={whatsappUrl}>Pedir orçamento no WhatsApp ↗</a><a class="button secondary" href="/#servicos">Explorar outros serviços ←</a></div></section></Base>
